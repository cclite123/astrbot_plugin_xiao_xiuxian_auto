      "status_timeout_sec": {
        "description": "状态回执超时（秒）",
        "type": "float",
        "default": 20.0
      },
      "challenge_timeout_sec": {
        "description": "挑战回执超时（秒）",
        "type": "float",
        "default": 60.0
      },
      "max_failures": {
        "description": "最大连续失败次数",
        "type": "int",
