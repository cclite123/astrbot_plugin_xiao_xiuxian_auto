        "default": true
      },
      "include_skill_training": {
        "description": "纳入灵界技艺修行",
        "type": "bool",
        "hint": "是否把「灵界技艺修行」纳入 ROI 候选。",
        "default": true
      },
      "include_skill_breakthrough": {
        "description": "纳入灵界技艺突破",
        "type": "bool",
        "hint": "当前突破成本/收益未完全确认，默认关闭。",
        "default": false
      },
      "max_sim_steps": {
        "description": "ROI 模拟最大步数",
        "type": "int",
        "hint": "用于「灵界规划序列」和「灵界规划详情」。",
        "default": 15
      }
    }
