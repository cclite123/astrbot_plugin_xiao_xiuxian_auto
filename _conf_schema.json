{
  "captcha": {
    "description": "全局验证码守卫",
    "type": "object",
    "hint": "验证码出现时暂停本群所有自动指令，使用视觉模型识别并点击后自动恢复。",
    "items": {
      "enabled": {"description": "启用验证码守卫", "type": "bool", "default": true},
      "vision_api_key": {"description": "视觉模型 API Key", "type": "string", "default": ""},
      "vision_base_url": {"description": "视觉模型 Base URL", "type": "string", "default": "https://ark.cn-beijing.volces.com/api/v3"},
      "vision_model": {"description": "视觉模型 ID", "type": "string", "default": ""},
      "debug_print": {"description": "验证码调试日志", "type": "bool", "default": true, "hint": "记录识别、匹配、点击和官方回执的完整诊断链路；API Key 与 callback_data 不会明文输出。"},
      "auto_resume": {"description": "官方确认验证通过后自动恢复", "type": "bool", "default": true, "hint": "点击接口成功仅代表已提交；插件会继续暂停，直到收到官方成功回执。"}
    }
  },
  "bounty": {
    "description": "悬赏模块配置",
    "type": "object",
    "hint": "控制悬赏策略、重试时间、每日启动时间和随机抖动。",
    "items": {
      "default_strategy": {
        "description": "默认悬赏策略",
        "type": "string",
        "hint": "修为：优先修为收益；价值：优先额外机缘价值；耗时：优先最短耗时。",
        "default": "价值",
        "options": ["修为", "价值", "耗时"]
      },
      "retry_when_running_sec": {
        "description": "运行中重试间隔（秒）",
        "type": "int",
        "default": 30
      },
      "post_finish_delay_sec": {
        "description": "完成后延迟（秒）",
        "type": "int",
        "default": 30
      },
      "next_morning_hour": {
        "description": "次日启动小时",
        "type": "int",
        "default": 8
      },
      "daily_start_time": {
        "description": "每日启动时间",
        "type": "string",
        "hint": "格式 HH:MM，如 08:30。",
        "default": "08:30"
      },
      "jitter_seconds": {
        "description": "随机抖动秒数",
        "type": "int",
        "hint": "在每日启动时间基础上随机延迟 0~N 秒，避免固定时间触发。",
        "default": 600
      },
      "response_timeout_sec": {
        "description": "回执超时（秒）",
        "type": "int",
        "default": 300
      },
      "max_response_retries": {
        "description": "最大回执重试次数",
        "type": "int",
        "default": 3
      }
    }
  },
  "secret": {
    "description": "秘境模块配置",
    "type": "object",
    "hint": "控制秘境每日启动时间和随机抖动。",
    "items": {
      "daily_start_time": {
        "description": "每日启动时间",
        "type": "string",
        "hint": "格式 HH:MM，如 12:35。",
        "default": "12:35"
      },
      "jitter_seconds": {
        "description": "随机抖动秒数",
        "type": "int",
        "default": 600
      }
    }
  },
  "sect": {
    "description": "宗门任务模块配置",
    "type": "object",
    "hint": "配置会用于首次创建账号的宗门任务状态；已通过指令设置过的账号保持其原有任务和时间。",
    "items": {
      "daily_start_time": {
        "description": "默认每日启动时间",
        "type": "string",
        "hint": "格式 HH:MM，如 06:30。",
        "default": "06:30"
      },
      "default_enabled_tasks": {
        "description": "默认启用的任务目标",
        "type": "list",
        "hint": "可选：密令、除魔、仙丹、疏财、红尘；留空表示首次使用时不预选任务。",
        "default": []
      },
      "response_timeout_sec": {
        "description": "任务回执超时（秒）",
        "type": "int",
        "default": 120
      },
      "max_response_retries": {
        "description": "最大回执重试次数",
        "type": "int",
        "default": 3
      },
      "task_refresh_delay_sec": {
        "description": "非目标任务刷新等待（秒）",
        "type": "int",
        "default": 70
      },
      "hp_recovery_min_sec": {
        "description": "气血恢复最短等待（秒）",
        "type": "int",
        "default": 180
      },
      "hp_recovery_cultivate_count": {
        "description": "修炼回血完成所需次数",
        "type": "int",
        "default": 3
      }
    }
  },
  "seclusion_guard": {
    "description": "闭关/禁发保护配置",
    "type": "object",
    "hint": "需要退出闭关时会按这里的策略尝试处理。",
    "items": {
      "enabled": {
        "description": "闭关保护开关",
        "type": "bool",
        "default": true
      },
      "prefer_sect_exit": {
        "description": "优先使用宗门出关",
        "type": "bool",
        "default": true
      },
      "retry_delay_sec": {
        "description": "重试延迟（秒）",
        "type": "float",
        "default": 1.5
      },
      "max_exit_attempts": {
        "description": "最大退出尝试次数",
        "type": "int",
        "default": 2
      }
    }
  },
  "inventory_ops": {
    "description": "背包物品操作配置",
    "type": "object",
    "hint": "一键上架、一键炼金、背包分页、黑白名单等原有功能使用。",
    "items": {
      "enabled": {
        "description": "模块开关",
        "type": "bool",
        "default": true
      },
      "max_market_price": {
        "description": "上架最高价格",
        "type": "int",
        "default": 5000
      },
      "send_interval_sec": {
        "description": "发送间隔（秒）",
        "type": "float",
        "default": 1.0
      },
      "page_timeout_sec": {
        "description": "分页超时（秒）",
        "type": "float",
        "default": 30.0
      },
      "action_timeout_sec": {
        "description": "操作超时（秒）",
        "type": "float",
        "default": 30.0
      },
      "max_pages": {
        "description": "最大分页数",
        "type": "int",
        "default": 30
      }
    }
  },
  "auto_alchemy": {
    "description": "炼丹模块配置",
    "type": "object",
    "hint": "支持批量炼丹、指定丹药炼丹、背包炼丹、暂停/继续/关闭、多轮购买等。",
    "items": {
      "enabled": {
        "description": "炼丹总开关",
        "type": "bool",
        "hint": "false 时炼丹相关指令不执行。",
        "default": true
      },
      "market_pages": {
        "description": "坊市药材总页数",
        "type": "int",
        "hint": "当前固定为 1-8 页。",
        "default": 8
      },
      "send_interval_sec": {
        "description": "指令发送间隔（秒）",
        "type": "float",
        "default": 1.2
      },
      "page_timeout_sec": {
        "description": "分页回执超时（秒）",
        "type": "float",
        "default": 30.0
      },
      "max_page_retries": {
        "description": "分页采集最大重试次数",
        "type": "int",
        "default": 1
      },
      "default_yield_count": {
        "description": "默认成丹数量",
        "type": "int",
        "hint": "当前按 6 颗计算利润。",
        "default": 6
      },
      "batch_buy_enabled": {
        "description": "批量购买开关",
        "type": "bool",
        "hint": "开启炼丹后是否执行购买流程；false 时只计算/展示。",
        "default": true
      },
      "batch_buy_send_interval_sec": {
        "description": "批量购买发送间隔（秒）",
        "type": "float",
        "default": 1.2
      },
      "batch_buy_result_timeout_sec": {
        "description": "批量购买整体等待时间（秒）",
        "type": "float",
        "hint": "旧字段，保留兼容。",
        "default": 180.0
      },
      "max_profitable_report_count": {
        "description": "盈利丹方最大展示数",
        "type": "int",
        "default": 30
      },
      "purchase_response_timeout_sec": {
        "description": "购买回执超时（秒）",
        "type": "float",
        "hint": "30 秒无有效回执则结束验证码空窗期，跳过当前购买并继续后续流程。",
        "default": 30.0
      },
      "captcha_wait_sec": {
        "description": "验证码等待窗口（秒）",
        "type": "float",
        "hint": "超时后恢复继续。",
        "default": 30.0
      },
      "busy_retry_delay_sec": {
        "description": "繁忙重试延迟（秒）",
        "type": "float",
        "hint": "官方回执包含「太繁忙」时不判定购买失败，等待该秒数后重试。",
        "default": 15.0
      },
      "alchemy_confirm_timeout_sec": {
        "description": "炼丹确认超时（秒）",
        "type": "float",
        "hint": "炼丹指令发出后等待「恭喜道友成功炼成丹药」的超时时间。",
        "default": 20.0
      },
      "alchemy_send_interval_sec": {
        "description": "炼丹指令间隔（秒）",
        "type": "float",
        "default": 1.2
      },
      "min_profit_6pill": {
        "description": "6 丹最低利润阈值（万）",
        "type": "int",
        "hint": "低于该值不纳入炼丹。",
        "default": 130
      },
      "page_index_cache_enabled": {
        "description": "药材页码索引缓存",
        "type": "bool",
        "hint": "页码稳定时可减少每次全量查 1-8 页。",
        "default": true
      },
      "merge_buy_queue": {
        "description": "合并同名药材购买需求",
        "type": "bool",
        "hint": "合并后仍会记录丹方材料归属。",
        "default": true
      },
      "batch_mode_plan_lock": {
        "description": "批量模式方案锁",
        "type": "bool",
        "hint": "选定丹方后不因「不是最优」切换，只判断是否仍达利润阈值。",
        "default": true
      },
      "target_mode_plan_lock": {
        "description": "指定丹药模式方案锁",
        "type": "bool",
        "hint": "false 时价格变化只在指定丹药内部重新选最优丹方。",
        "default": false
      },
      "batch_repeat_until_threshold": {
        "description": "批量模式重复匹配",
        "type": "bool",
        "hint": "是否允许同一丹药匹配多条盈利丹方，直到低于利润阈值。",
        "default": true
      },
      "max_batch_formula_count": {
        "description": "批量模式最大主丹方数",
        "type": "int",
        "hint": "本轮最多锁定的主丹方数量。",
        "default": 6
      },
      "max_formula_per_pill": {
        "description": "每条主丹方炼制炉数",
        "type": "int",
        "hint": "总炉数约为 max_batch_formula_count × max_formula_per_pill。最小按 1 处理。",
        "default": 6
      },
      "batch_fast_start_from_snapshot": {
        "description": "快速启动从快照",
        "type": "bool",
        "hint": "是否允许使用上次价格快照快速启动，避免每次固定查 8 页。",
        "default": true
      },
      "batch_snapshot_max_age_sec": {
        "description": "快照有效期（秒）",
        "type": "int",
        "hint": "21600=6小时，0 表示只要有快照就不按时间过期。",
        "default": 21600
      },
      "batch_refresh_selected_pages": {
        "description": "快速启动后刷新候选页",
        "type": "bool",
        "hint": "快速启动后是否只刷新本轮候选丹方涉及的药材页。",
        "default": true
      },
      "retry_failed_after_batch": {
        "description": "批量结束后重试失败药材",
        "type": "bool",
        "hint": "购买失败的药材是否在第一轮批量购买结束后集中重试一轮。",
        "default": true
      },
      "multi_round_buy_enabled": {
        "description": "多轮购买机制",
        "type": "bool",
        "hint": "同名药材一轮只买一次，后续需求放到下一轮。",
        "default": true
      },
      "refresh_pages_each_buy_round": {
        "description": "每轮购买刷新页码",
        "type": "bool",
        "hint": "每进入一个页码组购买前，先重新查看该页获取最新真实购买指令。",
        "default": true
      },
      "target_unknown_price_execute": {
        "description": "未知售价允许执行",
        "type": "bool",
        "hint": "指定丹药如果没有固定炼金售价，是否允许按最低成本丹方执行，不做利润判断。",
        "default": true
      },
      "backpack_max_formula_count": {
        "description": "背包炼丹最大丹方数",
        "type": "int",
        "hint": "背包模式不强求最高利润，优先匹配已有药材。",
        "default": 10
      },
      "backpack_use_existing_as_free": {
        "description": "背包药材抵扣采购",
        "type": "bool",
        "hint": "背包已有药材抵扣实际采购数量；利润成本仍按药材实时坊市价格计算。",
        "default": true
      },
      "backpack_min_profit_6pill": {
        "description": "背包炼丹最低利润（万）",
        "type": "int",
        "hint": "0 表示只要 6 丹利润为正就允许炼制。",
        "default": 0
      },
      "backpack_require_existing_material": {
        "description": "背包炼丹需使用已有药材",
        "type": "bool",
        "hint": "true 时优先围绕背包库存匹配，不退化为普通坊市采购。",
        "default": true
      },
      "dynamic_herb_buy_during_market_scan": {
        "description": "遍历坊市时动态购买药材",
        "type": "bool",
        "hint": "遍历坊市时是否动态购买符合 herb_max_prices.yaml 最高价的药材；仅对当前页生效。",
        "default": false
      },
      "batch_mode_profit_threshold": {
        "description": "批量模式利润阈值（万灵石）",
        "type": "int",
        "hint": "低于该值的丹方不纳入批量炼丹。",
        "default": 50
      },
      "use_backpack_for_batch_mode": {
        "description": "批量模式使用背包抵扣",
        "type": "bool",
        "hint": "true 时背包已有药材抵扣缺口，只购买不足部分。",
        "default": true
      }
    }
  },
  "linjie_upgrade": {
    "description": "灵界升级模块配置",
    "type": "object",
