        "hint": "0 表示不保留。",
        "default": 0
      },
      "success_delay_sec": {
        "description": "成功后延迟（秒）",
        "type": "float",
        "hint": "收到升级成功回执后，间隔多少秒继续判断下一次升级。",
        "default": 0.5
      },
      "query_timeout_sec": {
        "description": "查询超时（秒）",
        "type": "float",
        "default": 20.0
      },
      "action_timeout_sec": {
        "description": "操作超时（秒）",
        "type": "float",
